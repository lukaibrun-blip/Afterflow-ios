{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "afterflow.prsevend",
    "name": "Afterflow",
    "version": "v2.1.3",
    "developer": "prsevend",
    "description": "a predictive input cheat that fixes your early clicks and makes them accurate.",
    "tags": [
        "gameplay",
        "utility",
        "developer"
    ],
    "settings": {
        "terminal-title": {
            "type": "title",
            "name": "terminal",
            "description": "terminal window options",
            "platforms": ["win", "mac"]
        },
        "terminal-enabled": {
            "type": "bool",
            "name": "enable terminal",
            "description": "allow the terminal key to open the afterflow log window",
            "default": true,
            "platforms": ["win", "mac"]
        },
        "keybinds-title": {
            "type": "title",
            "name": "keybinds",
            "description": "change geodes keybinding anytime for afterflow",
            "platforms": ["win", "mac"]
        },
        "keybind-stage": {
            "type": "keybind",
            "name": "cycle stages",
            "description": "cycle prediction stages",
            "category": "gameplay",
            "default": ["F6"],
            "platforms": ["win", "mac"]
        },
        "keybind-terminal": {
            "type": "keybind",
            "name": "terminal",
            "description": "open or close the afterflow terminal",
            "category": "universal",
            "default": ["F9"],
            "platforms": ["win", "mac"]
        },
        "ios-stage-title": {
            "type": "title",
            "name": "touch controls",
            "platforms": ["ios"]
        },
        "ios-stage": {
            "type": "int",
            "name": "prediction stage",
            "description": "Touch slider: 0 selects stage 1; 7 disables prediction and uses raw input.",
            "default": 0,
            "min": 0,
            "max": 7,
            "platforms": ["ios"]
        }
    }
}
